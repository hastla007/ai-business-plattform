APP_NAME="AI Business Engine"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_REGISTRATION_ENABLED=false
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1:8000,localhost:8080
APP_URL=https://example.invalid
APP_IMAGE=ai-business-engine:1.0.0
APP_RUN_MIGRATIONS=false
LOG_CHANNEL=stderr
LOG_LEVEL=info
FILESYSTEM_DISK=local
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=business_engine
DB_USERNAME=business_engine
DB_PASSWORD=replace-with-a-different-long-random-secret
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
AI_BASE_URL=http://host.docker.internal:8080
AI_API_KEY=
AI_CHAT_MODEL=llama-3.1-8b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_TIMEOUT=60
AI_MAX_RETRIES=2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
